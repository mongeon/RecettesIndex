@using MudBlazor
@using RecettesIndex.Models

@*
    Fiche de recette (bloc 1b du handoff).

    Une fiche typographique, plus une vignette. Disparaissent : le bloc dégradé de
    140px, l'icône alimentaire tirée au hasard du nom, la puce de note en
    superposition et la rangée de quatre boutons d'action en pied. Ils occupaient
    l'essentiel de la surface sans porter d'information ; la couleur ne sert plus
    qu'à la note, réduite à un filet de 3px sur le bord gauche.
*@

<article class="recipe-card" style="@($"border-left-color: {RatingEdgeColor};")">
    <div class="recipe-card-top">
        <span class="recipe-card-pizzas">
            @for (var i = 1; i <= 5; i++)
            {
                <MudIcon Icon="@(i <= Recipe.Rating ? Icons.Material.Filled.LocalPizza : Icons.Material.Outlined.LocalPizza)"
                         Class="@(i <= Recipe.Rating ? "card-pizza card-pizza-on" : "card-pizza")" />
            }
        </span>

        @if (Recipe.Rating > 0)
        {
            <span class="recipe-card-score">@Recipe.Rating/5</span>
        }

        <span class="recipe-card-spacer"></span>

        <button type="button"
                class="recipe-card-fav"
                aria-label="@(IsFavorite ? "Retirer des favoris" : "Ajouter aux favoris")"
                aria-pressed="@IsFavorite"
                @onclick="() => OnToggleFavorite.InvokeAsync(Recipe)">
            <MudIcon Icon="@(IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                     Class="@(IsFavorite ? "fav-icon fav-icon-on" : "fav-icon")" />
        </button>
    </div>

    <a class="recipe-card-name" href="@($"/recipes/{Recipe.Id}")">@Recipe.Name</a>

    @if (Recipe.Etiquettes.Count > 0)
    {
        <div class="recipe-card-tags">
            @foreach (var tag in Recipe.Etiquettes)
            {
                <span class="recipe-card-tag">@tag.Name</span>
            }
        </div>
    }

    @* Hauteur minimale même sans notes : sinon les cartes d'une même rangée
       cesseraient d'aligner leurs pieds. *@
    <p class="recipe-card-notes">@Recipe.Notes</p>

    <div class="recipe-card-sep"></div>

    <div class="recipe-card-foot">
        <MudIcon Icon="@SourceIcon" Class="@($"recipe-card-source-icon {SourceColorClass}")" />
        <span class="recipe-card-source">@SourceLabel</span>
        @if (Recipe.BookPage is int page)
        {
            <span class="recipe-card-page">p. @(page)</span>
        }
        <span class="recipe-card-spacer"></span>
        <span class="recipe-card-date">@RelativeDate(Recipe.CreationDate)</span>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Recipe Recipe { get; set; } = null!;
    [Parameter] public Book? Book { get; set; }
    [Parameter] public Store? Store { get; set; }
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter, EditorRequired] public EventCallback<Recipe> OnToggleFavorite { get; set; }

    /// <summary>
    /// The 3px left edge is the only colour left on the card, and it encodes the rating.
    /// Decorative, so it may sit below the text contrast threshold.
    /// </summary>
    private string RatingEdgeColor => Recipe.Rating switch
    {
        5 => "#6BCB77",
        4 => "var(--app-teal)",
        3 => "#E8A33D",
        2 or 1 => "#D9534F",
        _ => "var(--mud-palette-lines-default)"
    };

    private string SourceIcon =>
        Recipe.IsFromBook ? Icons.Material.Outlined.MenuBook
        : Recipe.IsFromStore ? Icons.Material.Outlined.Storefront
        : Recipe.IsFromUrl ? Icons.Material.Outlined.Language
        : Icons.Material.Outlined.Home;

    private string SourceColorClass =>
        Recipe.IsFromBook ? "source-book"
        : Recipe.IsFromStore ? "source-store"
        : "source-plain";

    private string SourceLabel =>
        Recipe.IsFromBook ? Book?.Name ?? "Livre"
        : Recipe.IsFromStore ? Store?.Name ?? "Magasin"
        : Recipe.IsFromUrl && !string.IsNullOrWhiteSpace(Recipe.Url) ? HostOf(Recipe.Url)
        : "Maison";

    private static string HostOf(string url)
        => Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.Host : url;

    private static string RelativeDate(DateTime date)
    {
        var span = DateTime.UtcNow - date;
        if (span.TotalDays < 1) return "Aujourd'hui";
        if (span.TotalDays < 2) return "Hier";
        if (span.TotalDays < 7) return $"Il y a {(int)span.TotalDays}j";
        if (span.TotalDays < 30) return $"Il y a {(int)(span.TotalDays / 7)} sem.";
        return date.ToString("MMM yyyy");
    }
}
