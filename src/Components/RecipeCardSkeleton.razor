@using MudBlazor

@*
    Silhouette de chargement de la fiche (bloc 1b).

    Elle suit la carte réelle : rangée de pizzas, titre, étiquettes, notes, pied.
    L'ancienne version annonçait un bloc image de 180px et trois boutons ronds que
    la carte n'a plus — le contenu semblait alors sauter en place à l'arrivée.
*@

<div class="skeleton-card">
    <div class="skeleton-card-top">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="88px" Height="15px" Animation="Animation.Wave" />
    </div>

    <MudSkeleton SkeletonType="SkeletonType.Text" Height="24px" Animation="Animation.Wave" Class="mt-2" />
    <MudSkeleton SkeletonType="SkeletonType.Text" Width="55%" Height="24px" Animation="Animation.Wave" />

    <div class="skeleton-card-tags">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="62px" Height="18px" Animation="Animation.Wave" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="48px" Height="18px" Animation="Animation.Wave" />
    </div>

    <MudSkeleton SkeletonType="SkeletonType.Text" Height="16px" Animation="Animation.Wave" Class="mt-2" />
    <MudSkeleton SkeletonType="SkeletonType.Text" Width="75%" Height="16px" Animation="Animation.Wave" />

    <div class="skeleton-card-foot">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="16px" Animation="Animation.Wave" />
    </div>
</div>

@code {
    // No parameters needed for skeleton loader
}
