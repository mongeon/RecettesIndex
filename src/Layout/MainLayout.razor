@using RecettesIndex.Pages
@inherits LayoutComponentBase
@implements IDisposable
@using RecettesIndex.Services
@inject AuthService AuthService
@inject MudBlazor.IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject MudBlazor.ISnackbar Snackbar
@inject RecettesIndex.Services.Abstractions.IErrorLoggingService ErrorLoggingService

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="@_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@* Jetons de marque hors palette MudBlazor : MudBlazor n'a pas de jeton
   « texte primaire » distinct du fond primaire, donc les deux rôles du corail
   et du turquoise sont exposés ici en variables CSS, redéfinies par thème.
   --app-accent / --app-teal   = la marque, pour les fonds et grandes icônes
   --app-accent-ink / --app-teal-ink = l'encre, pour tout ce qui se lit.
   Les valeurs fixes (indépendantes du thème) vivent dans wwwroot/css/app.css. *@
<style>
    :root {
        --app-accent-ink: @(_isDarkMode ? "#FF8A85" : "#C9403A");
        --app-accent-soft: @(_isDarkMode ? "rgba(255, 107, 107, 0.20)" : "rgba(255, 107, 107, 0.12)");
        --app-teal-ink: @(_isDarkMode ? "#4ECDC4" : "#1B7F78");
        --app-teal-soft: @(_isDarkMode ? "rgba(78, 205, 196, 0.20)" : "rgba(78, 205, 196, 0.12)");
        --app-field: @(_isDarkMode ? "#2A282F" : "#F2EFEB");
        --app-line-soft: @(_isDarkMode ? "rgba(255, 255, 255, 0.07)" : "rgba(0, 0, 0, 0.05)");
    }
</style>

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Primary" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-2 d-none d-sm-flex" Style="font-weight: 700; letter-spacing: -0.5px;">Mes Recettes</MudText>
        <MudSpacer />

        @* Un déclencheur, pas un champ : la saisie se fait dans la palette. Un vrai
           champ ici obligerait à taper deux fois, ou à recopier le terme. *@
        <button type="button" class="global-search d-none d-md-flex mr-3" @onclick="OpenPalette"
                aria-label="Rechercher une recette">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Class="global-search-icon" />
            <span class="global-search-text">Rechercher une recette, un livre, un auteur…</span>
            <span class="global-search-kbd">⌘K</span>
        </button>
        <MudTooltip Text="Rechercher une recette">
            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit"
                           Class="d-flex d-md-none" OnClick="OpenPalette" />
        </MudTooltip>

        <MudTooltip Text="Basculer en mode sombre">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                          Color="Color.Inherit" 
                          OnClick="@ToggleDarkMode" />
        </MudTooltip>
        
        @if (!AuthService.IsAuthenticated)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" 
                       Class="d-none d-sm-flex ml-1" OnClick="ShowSignInDialog">Se connecter</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Login" Color="Color.Inherit" 
                           Class="d-flex d-sm-none" OnClick="ShowSignInDialog" />
        }
        else
        {
            <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-1">
                <ActivatorContent>
                    <MudTooltip Text="@AuthService.UserEmail">
                        <MudAvatar Color="Color.Secondary" Size="Size.Small" Style="cursor: pointer; font-size: 0.85rem; font-weight: 700;">
                            @GetUserInitials(AuthService.UserEmail)
                        </MudAvatar>
                    </MudTooltip>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Disabled="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@AuthService.UserEmail</MudText>
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="SignOut" Icon="@Icons.Material.Filled.Logout">
                        Se déconnecter
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               Style="border-right: 1px solid var(--mud-palette-divider);">
        <NavMenu />
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 px-4">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    <div class="page-enter" @key="NavigationKey">
                        @Body
                    </div>
                </ChildContent>
                <ErrorContent Context="ex">
                    @{ _ = ErrorLoggingService.LogErrorAsync(ex, NavigationManager.Uri); }
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h5" Class="mt-4">Oups, quelque chose s'est mal passé</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@ex.Message</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetError">
                            Réessayer
                        </MudButton>
                    </MudContainer>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<CommandPalette @ref="_palette" />

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private string _currentPath = string.Empty;
    private ErrorBoundary? _errorBoundary;
    private CommandPalette? _palette;
    private DotNetObjectReference<MainLayout>? _selfRef;
    
    // Define light and dark themes.
    //
    // Contrast model (chantier 1 du handoff design) : la couleur de marque #FF6B6B
    // était utilisée à la fois comme fond et comme encre. En texte sur blanc elle
    // donne 2,8:1, sous la norme WCAG AA de 4,5:1 (et 1,9:1 pour le turquoise).
    // Les deux rôles sont maintenant séparés :
    //   - Primary / Secondary   = l'encre, ce qui se lit (texte, liens, boutons pleins)
    //   - PrimaryLighten / SecondaryLighten = la marque, réservée aux surfaces
    // Le corail de marque ne change pas ; il cesse simplement de servir d'encre.
    // Les *ContrastText sont choisis pour que rien ne pose du blanc sur un fond
    // saturé : en clair on fonce le fond, en sombre on fonce le texte.
    // Chaque paire est vérifiée >= 4,5:1 (ratios en commentaire).
    private MudTheme _currentTheme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#C9403A",              // corail action/encre — 4,9:1 sur blanc
            PrimaryContrastText = "#FFFFFF",  // 4,9:1 sur #C9403A
            PrimaryDarken = "#A6302B",        // survol des boutons pleins — 6,8:1
            PrimaryLighten = "#FF6B6B",       // corail de marque : fonds uniquement
            Secondary = "#1B7F78",            // turquoise encre — 4,8:1 sur blanc
            SecondaryContrastText = "#FFFFFF",// 4,8:1 — jamais de blanc sur #4ECDC4
            SecondaryDarken = "#14625C",      // 7,2:1
            SecondaryLighten = "#4ECDC4",     // turquoise de marque : fonds uniquement
            Tertiary = "#8A5300",             // ambre foncé — 6,3:1
            TertiaryContrastText = "#FFFFFF",
            TertiaryDarken = "#6B4000",
            // Les *Lighten sont fixés plutôt que dérivés : RecipeCard s'en sert
            // comme fin de dégradé sous une icône blanche de 72px (seuil 3:1).
            Info = "#1668B8",                 // 5,7:1
            InfoContrastText = "#FFFFFF",
            InfoDarken = "#11518F",
            InfoLighten = "#2A82D0",          // 4,0:1
            Success = "#1E6B33",              // 6,6:1
            SuccessContrastText = "#FFFFFF",
            SuccessDarken = "#155226",
            SuccessLighten = "#2E8C46",       // 4,2:1
            Warning = "#A34B00",              // 5,9:1
            WarningContrastText = "#FFFFFF",
            WarningDarken = "#7D3A00",
            WarningLighten = "#C25E00",       // 4,3:1
            Error = "#B03A36",                // 6,0:1
            ErrorContrastText = "#FFFFFF",
            ErrorDarken = "#8C2E2B",
            ErrorLighten = "#C94A45",         // 4,6:1
            Background = "#FAF8F6",
            Surface = "#FFFFFF",
            AppbarBackground = "#C9403A",     // fond foncé pour porter du texte blanc
            AppbarText = "#FFFFFF",
            DrawerBackground = "#FAF8F6",
            DrawerText = "#5F584F",           // encre 2 — 7,0:1
            DrawerIcon = "#5F584F",
            TextPrimary = "#26231F",          // encre 1 — 15,6:1
            TextSecondary = "#5F584F",        // encre 2 — 7,0:1
            TextDisabled = "#9B9288",         // encre 3 — 3,1:1, libellés seulement
            ActionDefault = "#5F584F",
            LinesDefault = "rgba(0, 0, 0, 0.09)",
            LinesInputs = "rgba(0, 0, 0, 0.09)",
            TableLines = "rgba(0, 0, 0, 0.05)",
            Divider = "rgba(0, 0, 0, 0.09)",
            DividerLight = "rgba(0, 0, 0, 0.05)"
        },
        PaletteDark = new PaletteDark
        {
            // En sombre le corail vif passe en texte (5,9:1) : le seul cas fautif
            // est le blanc sur bouton corail plein, corrigé par un encrage foncé.
            Primary = "#FF6B6B",              // 5,9:1 sur la surface sombre
            PrimaryContrastText = "#201F24",  // texte foncé, jamais blanc — 5,9:1
            PrimaryDarken = "#F0574F",        // survol des boutons pleins — 4,8:1
            PrimaryLighten = "#FF8A85",       // encre corail des liens/titres — 7,2:1
            Secondary = "#4ECDC4",            // 8,5:1
            SecondaryContrastText = "#17161A",
            SecondaryDarken = "#3FB8AF",
            SecondaryLighten = "#7FDCD6",
            Tertiary = "#FFD166",             // 11,4:1
            TertiaryContrastText = "#201F24",
            TertiaryDarken = "#E8B94A",
            Info = "#5BC4BF",                 // 7,9:1
            InfoContrastText = "#201F24",
            InfoDarken = "#45ADA8",
            Success = "#6BCB77",              // 8,1:1
            SuccessContrastText = "#201F24",
            SuccessDarken = "#54B460",
            Warning = "#F4A261",              // 7,9:1
            WarningContrastText = "#201F24",
            WarningDarken = "#DC8944",
            Error = "#FF8A85",                // 7,2:1
            ErrorContrastText = "#201F24",
            ErrorDarken = "#F0706A",
            Background = "#17161A",
            Surface = "#201F24",
            AppbarBackground = "#201F24",
            DrawerBackground = "#1B1A1F",
            DrawerText = "#A8A29B",           // encre 2 — 6,5:1
            DrawerIcon = "#A8A29B",
            TextPrimary = "#F2EFEA",          // encre 1 — 14,3:1
            TextSecondary = "#A8A29B",        // encre 2 — 6,5:1
            TextDisabled = "#7C766F",         // encre 3 — 3,7:1, libellés seulement
            ActionDefault = "#A8A29B",
            LinesDefault = "rgba(255, 255, 255, 0.12)",
            LinesInputs = "rgba(255, 255, 255, 0.12)",
            TableLines = "rgba(255, 255, 255, 0.07)",
            Divider = "rgba(255, 255, 255, 0.12)",
            DividerLight = "rgba(255, 255, 255, 0.07)"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "1rem",
                FontWeight = "400",
                LineHeight = "1.6"
            },
            H1 = new H1Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "2.5rem",
                FontWeight = "700",
                LineHeight = "1.2"
            },
            H2 = new H2Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "2rem",
                FontWeight = "700",
                LineHeight = "1.25"
            },
            H3 = new H3Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "1.75rem",
                FontWeight = "700",
                LineHeight = "1.3"
            },
            H4 = new H4Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "1.5rem",
                FontWeight = "600",
                LineHeight = "1.35"
            },
            H5 = new H5Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "1.25rem",
                FontWeight = "600",
                LineHeight = "1.4"
            },
            H6 = new H6Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "1.125rem",
                FontWeight = "600",
                LineHeight = "1.4"
            },
            Body1 = new Body1Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "1rem",
                FontWeight = "400",
                LineHeight = "1.6"
            },
            Body2 = new Body2Typography
            {
                FontFamily = new[] { "Nunito", "Helvetica", "Arial", "sans-serif" },
                FontSize = "0.875rem",
                FontWeight = "400",
                LineHeight = "1.57"
            }
        }
    };
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();

            // Load user's theme preference from local storage
            var storedTheme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "recipes-theme-preference");
            _isDarkMode = storedTheme == "dark";

            _selfRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("recettesShortcuts.register", _selfRef);

            StateHasChanged();
        }
    }

    /// <summary>Ouvre la palette depuis ⌘K. Appelée par le script de index.html.</summary>
    [JSInvokable]
    public async Task OpenPalette()
    {
        if (_palette is not null)
        {
            await _palette.OpenAsync();
        }
    }

    private string NavigationKey => NavigationManager.Uri;

    protected override void OnInitialized()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;
        AuthService.SessionExpired += OnSessionExpired;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
    }

    private void ResetError()
    {
        _errorBoundary?.Recover();
    }
    
    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
    
    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        // Save the user's preference to local storage
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "recipes-theme-preference", _isDarkMode ? "dark" : "light");
    }

    private async Task ShowSignInDialog()
    {
        var options = new MudBlazor.DialogOptions { CloseButton = true, MaxWidth = MudBlazor.MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<SignInDialog>("Connexion", options);
        await dialog.Result;
    }

    private async Task SignOut()
    {
        await AuthService.SignOutAsync();
        Snackbar.Add("Vous avez été déconnecté.", Severity.Info);
        NavigationManager.NavigateTo("/");
    }

    private void OnSessionExpired()
    {
        _ = InvokeAsync(() =>
        {
            Snackbar.Add("Votre session a expiré. Veuillez vous reconnecter.", Severity.Warning);
            StateHasChanged();
        });
    }

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetUserInitials(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return "?";
        var name = email.Split('@')[0];
        var parts = name.Split('.', '-', '_');
        if (parts.Length == 1) return name.Substring(0, 1).ToUpper();
        return string.Concat(parts.Select(p => p.Length > 0 ? char.ToUpper(p[0]) : '?')).Substring(0, Math.Min(2, parts.Count()));
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= OnAuthStateChanged;
        AuthService.SessionExpired -= OnSessionExpired;
        NavigationManager.LocationChanged -= OnLocationChanged;
        _selfRef?.Dispose();
    }
}
