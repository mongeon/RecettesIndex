@page "/authors"
@inject NavigationManager NavigationManager

@*
    Redirection vers Sources (bloc 4c).

    Celle-ci est la disparition de fond du chantier : un auteur n'a pas de contenu
    propre, c'est un attribut du livre. Il devient un filtre dans Sources, plus une
    destination. La route mène donc à la liste des livres, où le menu « Auteur » prend
    le relais.
*@

<PageTitle>Auteurs - Mes Recettes</PageTitle>

@code {
    protected override void OnInitialized() =>
        NavigationManager.NavigateTo("/sources?type=book", replace: true);
}
