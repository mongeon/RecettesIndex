@page "/recipes"
@using Microsoft.Extensions.Logging
@using MudBlazor
@using RecettesIndex.Models
@using RecettesIndex.Services
@using RecettesIndex.Services.Abstractions
@using RecettesIndex.Components
@using Microsoft.JSInterop
@inject AuthService AuthService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ILogger<Recipes> Logger
@inject IRecipeService RecipeService
@inject IEtiquetteService EtiquetteService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@implements IDisposable

<PageTitle>Recettes</PageTitle>

<MudPaper Class="pa-4">
    <!-- En-tête de contenu (bloc 1a) : ce que la page contient à gauche,
         comment on la regarde à droite. -->
    <div class="page-head">
        <div>
            <h1 class="page-title">Recettes</h1>
            <div class="page-subtitle">@CollectionSummary</div>
        </div>

        <div class="page-head-controls">
            @* Même composant que les filtres : le tri est un choix parmi une liste,
               exactement comme « Livre » ou « Note ». *@
            <RecipeFilterMenu Label="Trié par"
                              SelectedLabel="@SortLabelText"
                              SelectedValue="@sortColumn"
                              IsActive="true"
                              AlignRight="true"
                              Options="@SortOptions"
                              OnSelected="@(v => SetSort(v ?? RecipeSortConstants.CreatedAt))" />

            <div class="view-toggle" role="group" aria-label="Affichage">
                <button type="button"
                        class="@(isCardView ? "view-toggle-btn" : "view-toggle-btn view-toggle-on")"
                        aria-pressed="@(!isCardView)"
                        title="Vue liste"
                        @onclick="@(() => isCardView = false)">
                    <MudIcon Icon="@Icons.Material.Outlined.ViewList" />
                </button>
                <button type="button"
                        class="@(isCardView ? "view-toggle-btn view-toggle-on" : "view-toggle-btn")"
                        aria-pressed="@isCardView"
                        title="Vue grille"
                        @onclick="@(() => isCardView = true)">
                    <MudIcon Icon="@Icons.Material.Outlined.GridView" />
                </button>
            </div>
        </div>
    </div>

    <!-- Barre de filtres unique : remplace les puces rapides, le panneau
         « Filtres Avancés » et la rangée de puces d'état actif. -->
    <RecipeFilterBar SearchTerm="@Filters.SearchTerm"
                     RatingFilter="@Filters.RatingFilter"
                     BookFilter="@Filters.BookFilter"
                     StoreFilter="@Filters.StoreFilter"
                     AuthorFilter="@Filters.AuthorFilter"
                     HasActiveFilters="@Filters.HasActiveFilters()"
                     ResultCount="@filteredTotal"
                     Placeholder="@(isCardView ? "Filtrer cette liste…" : "Rechercher une recette, un livre, un auteur…")"
                     Books="@books"
                     Stores="@stores"
                     Authors="@authors"
                     Etiquettes="@etiquettes"
                     BookRecipeCounts="@bookRecipeCounts"
                     StoreRecipeCounts="@storeRecipeCounts"
                     AuthorRecipeCounts="@authorRecipeCounts"
                     EtiquetteCounts="@etiquetteRecipeCounts"
                     SelectedEtiquetteIds="@Filters.SelectedEtiquetteIds"
                     OnSearchChanged="OnSearchChanged"
                     OnRatingChanged="OnRatingChanged"
                     OnBookChanged="OnBookChanged"
                     OnStoreChanged="OnStoreChanged"
                     OnAuthorChanged="OnAuthorChanged"
                     OnEtiquetteToggled="OnEtiquetteToggled"
                     OnClearAllFilters="ClearAllFilters" />

    <!-- Loading State -->
    @if (isLoading)
    {
        <RecipeLoadingState IsCardView="@isCardView" SkeletonCount="8" />
    }
    else if (errorMessage != null)
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (currentRecipes.Count == 0)
    {
        <!-- Empty State -->
        <EmptyState Icon="@Icons.Material.Filled.RestaurantMenu"
                    IconColor="Color.Secondary"
                    Title="@GetEmptyStateTitle()"
                    Message="@GetEmptyStateMessage()"
                    ShowAction="@(!Filters.HasActiveFilters() && AuthService.IsAuthenticated)"
                    ActionText="Ajouter votre première recette"
                    ActionIcon="@Icons.Material.Filled.Add"
                    OnActionClick="ShowAddDialog"
                    SecondaryActionText="@(Filters.HasActiveFilters() ? "Réinitialiser les filtres" : null)"
                    OnSecondaryActionClick="ClearAllFilters" />
    }
    else
    {
        <!-- Card View -->
        @if (isCardView)
        {
            <RecipeGridView Recipes="@currentRecipes"
                           Books="@books"
                           Stores="@stores"
                           FavoriteRecipeIds="@favoriteRecipeIds"
                           CurrentPage="@currentPage"
                           TotalPages="@totalPages"
                           TotalCount="@filteredTotal"
                           OnToggleFavorite="ToggleFavorite"
                           OnPageChanged="OnPageChanged" />
        }
        else
        {
            <!-- Liste dense -->
            <RecipeListView Recipes="@currentRecipes"
                            Books="@books"
                            Stores="@stores"
                            TotalCount="@filteredTotal"
                            HasMore="@(currentRecipes.Count < filteredTotal)"
                            LoadMoreStep="@pageSize"
                            OnLoadMore="LoadMoreAsync" />
        }
    }
    
    @if (AuthService.IsAuthenticated)
    {
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="ShowAddDialog" Label="Ajouter"
                Style="position: fixed; bottom: 24px; right: 24px; z-index: 100;" />
    }
</MudPaper>

@code {
    private List<Book> books = [];
    private List<Author> authors = [];
    private List<Store> stores = [];
    // Tri courant : la liste et la grille partagent le même ordre.
    private string sortColumn = RecipeSortConstants.CreatedAt;
    private bool sortDescending = true;

    /// <summary>« 42 recettes · 9 livres · 4 magasins » — ce que contient la collection.</summary>
    private string CollectionSummary
    {
        get
        {
            var parts = new List<string> { $"{totalCount} recette{(totalCount > 1 ? "s" : "")}" };
            if (books.Count > 0) parts.Add($"{books.Count} livre{(books.Count > 1 ? "s" : "")}");
            if (stores.Count > 0) parts.Add($"{stores.Count} magasin{(stores.Count > 1 ? "s" : "")}");
            return string.Join(" · ", parts);
        }
    }

    private static readonly List<RecipeFilterMenu.Option> SortOptions = new()
    {
        new(RecipeSortConstants.CreatedAt, "Ajout récent", null),
        new(RecipeSortConstants.Name, "Nom", null),
        new(RecipeSortConstants.Rating, "Note", null),
        new(RecipeSortConstants.Page, "Page", null)
    };

    private string SortLabelText => sortColumn switch
    {
        RecipeSortConstants.Name => "Nom",
        RecipeSortConstants.Rating => "Note",
        RecipeSortConstants.Page => "Page",
        _ => "Ajout récent"
    };

    private async Task SetSort(string column)
    {
        if (sortColumn == column)
        {
            return;
        }

        sortColumn = column;
        // Le nom se lit de A à Z et un numéro de page en montant ; une date ou une note
        // se lisent du plus fort au plus faible. La règle est énumérée plutôt que niée :
        // « tout sauf le nom descend » se serait trompée dès la deuxième colonne montante.
        sortDescending = column is not (RecipeSortConstants.Name or RecipeSortConstants.Page);
        currentPage = 1;
        await LoadCardViewData();
    }

    /// <summary>
    /// Ajoute la page suivante à celles déjà affichées, au lieu de remplacer la liste :
    /// c'est ce que promet « Charger 20 de plus ».
    /// </summary>
    private async Task LoadMoreAsync()
    {
        currentPage++;
        await LoadCardViewData(append: true);
    }

    // All filter-related state is encapsulated in RecipeFilterState
    private RecipeFilterState Filters { get; } = new();

    private List<int> favoriteRecipeIds = new();

    // Filter counts.
    //
    // fiveStarCount, fourPlusStarCount, unratedCount and favoritesCount currently have no
    // reader: the quick-filter chips that used them are gone, folded into the filter bar.
    // They are kept — along with the ShowFavorites / ShowRecent / ShowUnrated /
    // ApplyQuickFilter handlers below — because they are precisely the "MES VUES" saved
    // views of the side menu, which lands with the common chrome. Deleting them now would
    // mean writing them again next.
    private int totalCount = 0;
    private int fiveStarCount = 0;
    private int fourPlusStarCount = 0;
    private int unratedCount = 0;
    private int favoritesCount = 0;
    private Dictionary<int, int> bookRecipeCounts = new();
    private Dictionary<int, int> storeRecipeCounts = new();
    private Dictionary<int, int> authorRecipeCounts = new();
    private List<Etiquette> etiquettes = [];
    private Dictionary<int, int> etiquetteRecipeCounts = new();
    
    // View state
    private bool _isCardView = false;
    private bool isCardView 
    { 
        get => _isCardView;
        set
        {
            if (_isCardView != value)
            {
                _isCardView = value;
                _ = OnViewModeChanged();
            }
        }
    }
    
    private bool isLoading = true;
    private List<Recipe> currentRecipes = new();
    private int currentPage = 1;
    private int pageSize = PaginationConstants.RecipesDefaultPageSize;
    private int totalPages = 0;
    private int filteredTotal = 0;
    private const string ViewModeKey = "recipeViewMode";
    private string? errorMessage;

    protected override void OnInitialized()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadViewPreference();
            isLoading = true;
            await LoadRecipes();
            await LoadFilterCounts();
            await ReadQueryParameters();

            // Les deux vues lisent la même liste depuis le remplacement du MudTable.
            // La branche « liste » se contentait auparavant de lever le voile de
            // chargement, parce que le tableau allait chercher ses données lui-même
            // via ServerData ; sans lui, plus personne ne les chargeait.
            await LoadCardViewData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Recipes page");
            isLoading = false;
            StateHasChanged();
        }
    }
    
    protected override async Task OnParametersSetAsync()
    {
        await ReadQueryParameters();
    }
    
    #region Initialization Methods
    
    private async Task LoadViewPreference()
    {
        try
        {
            var viewMode = await JSRuntime.InvokeAsync<string>("localStorage.getItem", ViewModeKey);
            _isCardView = viewMode == "card";
        }
        catch
        {
            _isCardView = false;
        }
    }
    
    private async Task SaveViewPreference()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ViewModeKey, isCardView ? "card" : "table");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save view preference to localStorage");
        }
    }
    
    private static string? NormalizeFilterValue(string? value)
        => string.IsNullOrWhiteSpace(value) || value == "all" ? null : value;

    /// <summary>
    /// Reads the comma-separated tag IDs from the URL, ignoring anything unparseable
    /// rather than failing the whole page on a hand-edited link.
    /// </summary>
    private static HashSet<int> ParseTagIds(string? value)
    {
        var ids = new HashSet<int>();
        if (string.IsNullOrWhiteSpace(value))
        {
            return ids;
        }

        foreach (var part in value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(part, out var id) && id > 0)
            {
                ids.Add(id);
            }
        }
        return ids;
    }

    private async Task ReadQueryParameters()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var newSearch = query["search"] ?? string.Empty;
        var newRating = NormalizeFilterValue(query["rating"]);
        var newBook = NormalizeFilterValue(query["bookId"]);
        var newStore = NormalizeFilterValue(query["storeId"]);
        var newAuthor = NormalizeFilterValue(query["authorId"]);
        var newTags = ParseTagIds(query["tags"]);

        var changed =
            newSearch != Filters.SearchTerm
            || newRating != NormalizeFilterValue(Filters.RatingFilter)
            || newBook != NormalizeFilterValue(Filters.BookFilter)
            || newStore != NormalizeFilterValue(Filters.StoreFilter)
            || newAuthor != NormalizeFilterValue(Filters.AuthorFilter)
            || !newTags.SetEquals(Filters.SelectedEtiquetteIds);

        if (!changed)
        {
            return;
        }

        Filters.SearchTerm = newSearch;
        Filters.RatingFilter = newRating;
        Filters.BookFilter = newBook;
        Filters.StoreFilter = newStore;
        Filters.AuthorFilter = newAuthor;
        Filters.SelectedEtiquetteIds.Clear();
        foreach (var id in newTags)
        {
            Filters.SelectedEtiquetteIds.Add(id);
        }
        if (Filters.HasActiveFilters())
        {
            Filters.ShowAllRecipes = false;
        }
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        if (books.Any())
        {
            if (isCardView)
                await LoadCardViewData();
            else
                await Reload();
        }
    }

    /// <summary>
    /// Mirrors the advanced filters into the URL (replace, not push) so filtered
    /// views can be bookmarked and shared, then reloads the current view.
    /// </summary>
    private async Task ApplyFiltersAsync()
    {
        SyncFiltersToUrl();
        if (isCardView)
            await LoadCardViewData();
        else
            await Reload();
    }

    private void SyncFiltersToUrl()
    {
        var target = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(Filters.SearchTerm) ? null : Filters.SearchTerm,
            ["rating"] = NormalizeFilterValue(Filters.RatingFilter),
            ["bookId"] = NormalizeFilterValue(Filters.BookFilter),
            ["storeId"] = NormalizeFilterValue(Filters.StoreFilter),
            ["authorId"] = NormalizeFilterValue(Filters.AuthorFilter),
            // Comma-separated so a tag-filtered view stays shareable, like the others.
            ["tags"] = Filters.SelectedEtiquetteIds.Count == 0
                ? null
                : string.Join(",", Filters.SelectedEtiquetteIds.OrderBy(id => id)),
        });
        if (target != NavigationManager.Uri)
        {
            NavigationManager.NavigateTo(target, forceLoad: false, replace: true);
        }
    }
    
    private async Task LoadRecipes()
    {
        books = (await RecipeService.GetBooksAsync())?.ToList() ?? new();
        authors = (await RecipeService.GetAuthorsAsync())?.ToList() ?? new();
        stores = (await RecipeService.GetStoresAsync())?.ToList() ?? new();
        etiquettes = (await EtiquetteService.GetAllAsync()).ToList();
    }

    private async Task LoadFilterCounts()
    {
        favoriteRecipeIds = await LocalStorage.GetFavoritesAsync();
        etiquetteRecipeCounts = await EtiquetteService.GetRecipeCountsAsync();

        var allRecipes = await LoadAllRecipesForCounts();
        if (allRecipes.Count > 0)
        {
            totalCount = allRecipes.Count;
            fiveStarCount = allRecipes.Count(r => r.Rating == 5);
            fourPlusStarCount = allRecipes.Count(r => r.Rating >= 4);
            unratedCount = allRecipes.Count(r => r.Rating == 0 || r.Rating < 1);
            favoritesCount = favoriteRecipeIds.Count;
            
            bookRecipeCounts = allRecipes
                .Where(r => r.BookId.HasValue)
                .GroupBy(r => r.BookId!.Value)
                .ToDictionary(g => g.Key, g => g.Count());
            
            storeRecipeCounts = allRecipes
                .Where(r => r.StoreId.HasValue)
                .GroupBy(r => r.StoreId!.Value)
                .ToDictionary(g => g.Key, g => g.Count());
            
            authorRecipeCounts = new Dictionary<int, int>();
            foreach (var author in authors)
            {
                var authorBookIds = books.Where(b => b.Authors.Any(a => a.Id == author.Id)).Select(b => b.Id).ToHashSet();
                var count = allRecipes.Count(r => r.BookId.HasValue && authorBookIds.Contains(r.BookId.Value));
                authorRecipeCounts[author.Id] = count;
            }
        }
        else
        {
            totalCount = 0;
            fiveStarCount = 0;
            fourPlusStarCount = 0;
            unratedCount = 0;
            bookRecipeCounts = new Dictionary<int, int>();
            storeRecipeCounts = new Dictionary<int, int>();
            authorRecipeCounts = new Dictionary<int, int>();
        }
    }

    private async Task<List<Recipe>> LoadAllRecipesForCounts()
    {
        var result = await RecipeService.GetRecipeSummariesAsync();
        if (!result.IsSuccess)
        {
            Logger.LogWarning("Failed to load recipe summaries for counts: {Error}", result.ErrorMessage);
            return [];
        }
        return result.Value!.ToList();
    }
    
    #endregion
    
    #region Data Loading Methods
    
    private async Task OnViewModeChanged()
    {
        await SaveViewPreference();
        
        if (isCardView)
        {
            currentPage = 1;
            await LoadCardViewData();
        }
        else
        {
            await Reload();
        }
    }
    
    /// <param name="append">
    /// True quand « Charger 20 de plus » demande la page suivante : les résultats
    /// s'ajoutent à ceux déjà affichés au lieu de les remplacer.
    /// </param>
    private async Task LoadCardViewData(bool append = false)
    {
        // Le squelette de chargement remplacerait la liste entière ; en mode « charger
        // plus », ce qui est déjà lu doit rester à l'écran.
        isLoading = !append;
        errorMessage = null;
        try
        {
            int? rating = Filters.GetRatingFilter();
            int? bookId = Filters.GetBookIdFilter();
            int? storeId = Filters.GetStoreIdFilter();
            int? authorId = Filters.GetAuthorIdFilter();

            var result = await RecipeService.SearchAsync(
                Filters.SearchTerm, rating, bookId, storeId, authorId, currentPage, pageSize, sortColumn, sortDescending,
                etiquetteIds: Filters.SelectedEtiquetteIds);

            if (result.IsSuccess)
            {
                var items = result.Value.Items.ToList();
                var total = result.Value.Total;

                if (Filters.ShowRecentRecipes)
                {
                    var thirtyDaysAgo = DateTime.UtcNow.AddDays(-UIConstants.RecentRecipeDaysThreshold);
                    items = items.Where(r => r.CreationDate >= thirtyDaysAgo).ToList();
                    total = items.Count;
                }

                if (Filters.ShowFavorites)
                {
                    items = items.Where(r => favoriteRecipeIds.Contains(r.Id)).ToList();
                    total = items.Count;
                }
                
                if (append)
                {
                    currentRecipes.AddRange(items);
                }
                else
                {
                    currentRecipes = items;
                }
                filteredTotal = total;
                totalPages = (int)Math.Ceiling(total / (double)pageSize);
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Failed to load recipes";
                currentRecipes = [];
                filteredTotal = 0;
                totalPages = 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading card view data");
            errorMessage = "An error occurred while loading recipes";
            currentRecipes = [];
            totalPages = 0;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Les deux vues lisent désormais la même liste : la grille et la liste dense ne
    /// diffèrent que par leur rendu. Conservé comme point d'entrée distinct parce que
    /// les appelants raisonnent encore en « recharger la vue courante ».
    /// </summary>
    private Task Reload() => LoadCardViewData();
    
    #endregion
    
    // Filter helpers are now in RecipeFilterState (Filters property)
    
    #region Quick Filter Event Handlers
    
    private async Task ShowAll()
    {
        Filters.ShowAllRecipes = true;
        Filters.ShowRecentRecipes = false;
        Filters.QuickFilterRating = null;
        Filters.QuickFilterUnrated = false;
        Filters.RatingFilter = null;
        currentPage = 1;

        await ApplyFiltersAsync();
    }

    private async Task ApplyQuickFilter(int rating)
    {
        Filters.ShowAllRecipes = false;
        Filters.ShowRecentRecipes = false;
        Filters.QuickFilterRating = rating;
        Filters.QuickFilterUnrated = false;
        Filters.RatingFilter = rating >= 4 ? null : rating.ToString();
        currentPage = 1;

        await ApplyFiltersAsync();
    }

    private async Task ShowUnrated()
    {
        Filters.ShowAllRecipes = false;
        Filters.ShowRecentRecipes = false;
        Filters.QuickFilterRating = null;
        Filters.QuickFilterUnrated = true;
        Filters.RatingFilter = null;
        currentPage = 1;

        await ApplyFiltersAsync();
    }

    private async Task ShowFavorites()
    {
        if (Filters.ShowFavorites)
        {
            Filters.ShowFavorites = false;
            Filters.ShowAllRecipes = true;
        }
        else
        {
            Filters.ShowAllRecipes = false;
            Filters.ShowRecentRecipes = false;
            Filters.QuickFilterRating = null;
            Filters.QuickFilterUnrated = false;
            Filters.ShowFavorites = true;
            Filters.RatingFilter = null;
            Filters.BookFilter = null;
            Filters.AuthorFilter = null;
            Filters.SearchTerm = string.Empty;
        }

        currentPage = 1;

        await ApplyFiltersAsync();
    }

    private async Task ShowRecent()
    {
        Filters.ShowAllRecipes = false;
        Filters.ShowRecentRecipes = true;
        Filters.QuickFilterRating = null;
        Filters.QuickFilterUnrated = false;
        Filters.RatingFilter = null;
        Filters.BookFilter = null;
        Filters.AuthorFilter = null;
        Filters.SearchTerm = string.Empty;
        currentPage = 1;

        await ApplyFiltersAsync();
    }
    
    private async Task ShowRandom()
    {
        try
        {
            var countResult = await RecipeService.SearchAsync(null, null, null, null, null, 1, 1);
            if (!countResult.IsSuccess || countResult.Value.Total == 0)
            {
                Snackbar.Add("Aucune recette disponible", Severity.Warning);
                return;
            }
            
            var random = new Random();
            var randomIndex = random.Next(0, countResult.Value.Total);
            var randomPage = randomIndex + 1;
            
            var result = await RecipeService.SearchAsync(null, null, null, null, null, randomPage, 1);
            if (result.IsSuccess && result.Value.Items.Any())
            {
                var randomRecipe = result.Value.Items.First();
                NavigationManager.NavigateTo($"/recipes/{randomRecipe.Id}");
                Snackbar.Add($"🎲 Surprise: {randomRecipe.Name}!", Severity.Info);
            }
            else
            {
                Snackbar.Add("Aucune recette disponible", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error selecting random recipe");
            Snackbar.Add("Erreur lors de la sélection aléatoire", Severity.Error);
        }
    }

    private async Task ClearAllFilters()
    {
        Filters.Reset();
        currentPage = 1;

        await ApplyFiltersAsync();
    }
    
    #endregion
    
    #region Clear Individual Filter Methods
    
    private async Task ClearSearch()
    {
        Filters.SearchTerm = string.Empty;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task ClearRating()
    {
        Filters.RatingFilter = null;
        Filters.QuickFilterRating = null;
        Filters.QuickFilterUnrated = false;
        Filters.ShowAllRecipes = true;
        Filters.ShowRecentRecipes = false;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task ClearBook()
    {
        Filters.BookFilter = null;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task ClearStore()
    {
        Filters.StoreFilter = null;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task ClearAuthor()
    {
        Filters.AuthorFilter = null;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }
    
    #endregion
    
    #region Filter Changed Event Handlers
    
    private async Task OnRatingChanged(string? value)
    {
        Filters.RatingFilter = value;
        Filters.ShowAllRecipes = false;
        Filters.QuickFilterRating = null;
        Filters.QuickFilterUnrated = false;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task OnBookChanged(string? value)
    {
        Filters.BookFilter = value;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task OnStoreChanged(string? value)
    {
        Filters.StoreFilter = value;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task OnAuthorChanged(string? value)
    {
        Filters.AuthorFilter = value;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task OnEtiquetteToggled(int etiquetteId)
    {
        if (!Filters.SelectedEtiquetteIds.Remove(etiquetteId))
        {
            Filters.SelectedEtiquetteIds.Add(etiquetteId);
        }

        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }

    private async Task OnSearchChanged(string value)
    {
        Filters.SearchTerm = value;
        currentPage = 1;
        Filters.InvalidateFilterCountCache();

        await ApplyFiltersAsync();
    }
    
    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadCardViewData();
        StateHasChanged();
    }
    
    #endregion
    
    #region Recipe Action Methods
    
    private void ViewRecipe(Recipe recipe)
    {
        NavigationManager.NavigateTo($"/recipes/{recipe.Id}");
    }
    
    private void PrintRecipe(Recipe recipe)
    {
        NavigationManager.NavigateTo($"/recipes/{recipe.Id}/print");
    }
    
    private readonly HashSet<int> _togglingFavoriteIds = new();

    private async Task ToggleFavorite(Recipe recipe)
    {
        // Ignore rapid double-clicks while a toggle for this recipe is in flight
        if (!_togglingFavoriteIds.Add(recipe.Id))
            return;

        try
        {
            await LocalStorage.ToggleFavoriteAsync(recipe.Id);

            favoriteRecipeIds = await LocalStorage.GetFavoritesAsync();
            favoritesCount = favoriteRecipeIds.Count;

            if (Filters.ShowFavorites)
            {
                if (isCardView)
                    await LoadCardViewData();
                else
                    await Reload();
            }

            StateHasChanged();

            var isFavorite = favoriteRecipeIds.Contains(recipe.Id);
            Snackbar.Add(
                isFavorite ? $"'{recipe.Name}' ajouté aux favoris ❤️" : $"'{recipe.Name}' retiré des favoris",
                isFavorite ? Severity.Success : Severity.Info
            );
        }
        finally
        {
            _togglingFavoriteIds.Remove(recipe.Id);
        }
    }

    private async Task ShowAddDialog()
    {
        var options = new MudBlazor.DialogOptions { CloseButton = true, BackdropClick = false, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddRecipeDialog>("Ajouter une recette", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadRecipes();
            await LoadFilterCounts();
            
            if (isCardView)
            {
                await LoadCardViewData();
            }
            
            Snackbar.Add("Recette ajoutée avec succès!", Severity.Success);
        }
    }

    private async Task ShowEditDialog(Recipe recipeToEdit)
    {
        var parameters = new MudBlazor.DialogParameters { ["RecipeToEdit"] = recipeToEdit };
        var dialogOptions = new MudBlazor.DialogOptions { CloseButton = true, BackdropClick = false, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditRecipeDialog>("Modifier la recette", parameters, dialogOptions);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadRecipes();
            await LoadFilterCounts();
            
            if (isCardView)
            {
                await LoadCardViewData();
            }
            
            Snackbar.Add("Recette modifiée avec succès!", Severity.Success);
        }
    }

    private async Task DeleteRecipe(Recipe recipeToDelete)
    {
        try
        {
            bool? confirm = await DialogService.ShowMessageBoxAsync(
                "Confirmer la suppression",
                $"Êtes-vous sûr de vouloir supprimer la recette '{recipeToDelete.Name}' ? Cette action est irréversible.",
                yesText: "Supprimer",
                cancelText: "Annuler");

            if (confirm != true)
            {
                return;
            }

            var res = await RecipeService.DeleteAsync(recipeToDelete.Id);
            if (res.IsSuccess)
            {
                Snackbar.Add($"La recette '{recipeToDelete.Name}' a été supprimée avec succès.", Severity.Success);
                
                if (isCardView)
                {
                    await LoadCardViewData();
                }
                else
                {
                    await Reload();
                }
                
                await LoadFilterCounts();
            }
            else
            {
                Snackbar.Add(res.ErrorMessage ?? "Une erreur s'est produite lors de la suppression de la recette.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting recipe");
            Snackbar.Add("Une erreur s'est produite lors de la suppression de la recette. Veuillez réessayer.", Severity.Error);
        }
    }
    
    #endregion
    
    #region Helper Methods
    
    private string GetEmptyStateTitle() =>
        Filters.HasActiveFilters() ? "Aucune recette trouvée" : "Aucune recette pour le moment";

    private string GetEmptyStateMessage() =>
        Filters.HasActiveFilters()
            ? "Essayez de modifier vos filtres ou réinitialisez-les pour voir toutes les recettes."
            : AuthService.IsAuthenticated
                ? "Commencez par ajouter votre première recette pour construire votre collection personnelle."
                : "Connectez-vous (bouton en haut à droite) pour commencer à construire votre collection de recettes.";

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= OnAuthStateChanged;
    }
    
    #endregion
}
