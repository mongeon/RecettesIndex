@page "/"
@using Microsoft.Extensions.Logging
@using MudBlazor
@using RecettesIndex.Models
@using RecettesIndex.Services
@using RecettesIndex.Services.Abstractions
@inject AuthService AuthService
@inject IRecipeService RecipeService
@inject IEtiquetteService EtiquetteService
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@inject PaletteLauncher PaletteLauncher
@inject ISnackbar Snackbar
@inject ILogger<Home> Logger
@implements IDisposable

@*
    L'accueil maigre (bloc 3a).

    L'ancien accueil vendait l'app à quelqu'un qui l'utilise déjà : un bandeau dégradé,
    quatre compteurs, deux carrousels, et un bouton « Parcourir les Recettes » menant à
    la page qu'on cherchait justement à atteindre. Rien de tout ça ne répond à « c'était
    où, cette recette ? ».

    Il ne reste que ce qu'on veut 90 % du temps : de quoi chercher, et trois listes
    courtes de ce qu'on est en train de faire. Les statistiques déménagent au tableau de
    bord, dont c'est le sujet.
*@

<PageTitle>Mes Recettes</PageTitle>

<div class="home">
    <div class="home-hero">
        <h1 class="home-title">Qu'est-ce que vous cherchez&nbsp;?</h1>

        @* Un bouton déguisé en champ : la saisie se fait dans la palette, qui sait déjà
           chercher dans les recettes, les livres et les magasins. Deux champs de
           recherche voudraient dire deux recherches à tenir d'accord. *@
        <button type="button" class="home-search" @onclick="OpenPalette">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Class="home-search-icon" />
            <span class="home-search-hint">Une recette, un livre, un magasin…</span>
            <span class="home-search-badge">@ShortcutLabel</span>
        </button>

        @if (_topTags.Count > 0)
        {
            <div class="home-tags">
                @foreach (var tag in _topTags)
                {
                    <a class="home-tag" href="@($"/recipes?tags={tag.Id}")">@tag.Name</a>
                }
            </div>
        }
    </div>

    @if (_loading)
    {
        <div class="home-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        </div>
    }
    else
    {
        <div class="home-cards">
            <section class="home-card">
                <div class="home-card-head">
                    <MudIcon Icon="@Icons.Material.Outlined.History" Class="home-card-icon" />
                    <span>Consultées récemment</span>
                </div>
                @if (_recent.Count == 0)
                {
                    <p class="home-card-empty">Rien encore — la prochaine recette ouverte apparaîtra ici.</p>
                }
                else
                {
                    @foreach (var row in _recent)
                    {
                        <a class="home-row" href="@($"/recipes/{row.Id}")">
                            <span class="home-row-name">@row.Name</span>
                            <span class="home-row-meta home-row-meta-accent">@row.Meta</span>
                        </a>
                    }
                }
            </section>

            <section class="home-card">
                <div class="home-card-head">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Class="home-card-icon home-card-icon-accent" />
                    <span>Vos favoris</span>
                </div>
                @if (_favorites.Count == 0)
                {
                    <p class="home-card-empty">Aucun favori — le cœur sur une fiche de recette en ajoute un.</p>
                }
                else
                {
                    @foreach (var row in _favorites)
                    {
                        <a class="home-row" href="@($"/recipes/{row.Id}")">
                            <span class="home-row-name">@row.Name</span>
                            <span class="home-row-meta">@row.Meta</span>
                        </a>
                    }
                }
            </section>

            <section class="home-card">
                <div class="home-card-head">
                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Class="home-card-icon home-card-icon-teal" />
                    <span>À évaluer@(_unratedTotal > 0 ? $" · {_unratedTotal}" : "")</span>
                </div>
                @if (_toRate.Count == 0)
                {
                    <p class="home-card-empty">Tout est noté.</p>
                }
                else
                {
                    @foreach (var recipe in _toRate)
                    {
                        @* Noter sur place : ouvrir la fiche pour poser une note est le
                           détour qui fait qu'on ne la pose jamais. *@
                        <div class="home-row home-row-rate">
                            <a class="home-row-name" href="@($"/recipes/{recipe.Id}")">@recipe.Name</a>
                            <PizzaRating Value="0"
                                         ReadOnly="@(!AuthService.IsAuthenticated)"
                                         Size="Size.Small"
                                         ValueChanged="@(v => RateAsync(recipe, v))" />
                        </div>
                    }
                }
            </section>
        </div>
    }
</div>

@code {
    /// <summary>Rows per card. Beyond five, a short list stops being one.</summary>
    private const int CardRows = 5;

    /// <summary>Tags offered under the search field.</summary>
    private const int TagCount = 8;

    private sealed record Row(int Id, string Name, string Meta);

    private List<Row> _recent = [];
    private List<Row> _favorites = [];
    private List<Recipe> _toRate = [];
    private List<Etiquette> _topTags = [];
    private int _unratedTotal;
    private bool _loading = true;
    private bool _isApplePlatform;

    private string ShortcutLabel => _isApplePlatform ? "⌘K" : "Ctrl K";

    protected override void OnInitialized()
    {
        // Les pizzas de « À évaluer » ne sont cliquables que connecté : se connecter
        // depuis la barre du haut doit les activer sans changer de page.
        AuthService.AuthStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => AuthService.AuthStateChanged -= OnAuthStateChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading the home page");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        var summariesResult = await RecipeService.GetRecipeSummariesAsync();
        // Type explicite : le [] de repli n'a pas de type naturel, var ne lui en donnerait pas.
        IReadOnlyList<Recipe> summaries = summariesResult.IsSuccess ? summariesResult.Value : [];

        var recentEntries = await LocalStorage.GetRecentRecipesAsync();
        var favoriteIds = await LocalStorage.GetFavoritesAsync();

        // Le filtre de note du service ne couvre que 1 à 5 ; « pas encore notée » se lit
        // donc côté client, sur les résumés déjà en main.
        var unrated = summaries.Where(r => r.Rating <= 0).ToList();
        _unratedTotal = unrated.Count;

        var wanted = new HashSet<int>(recentEntries.Select(r => r.Id));
        wanted.UnionWith(favoriteIds.Take(CardRows));
        var unratedIds = unrated
            .OrderByDescending(r => r.CreationDate)
            .Take(CardRows)
            .Select(r => r.Id)
            .ToList();
        wanted.UnionWith(unratedIds);

        // Une seule requête pour les trois cartes : elles se recoupent souvent, et trois
        // allers-retours pour quinze lignes seraient trois de trop.
        var byId = new Dictionary<int, Recipe>();
        if (wanted.Count > 0)
        {
            var recipesResult = await RecipeService.GetRecipesByIdsAsync(wanted.ToList());
            if (recipesResult.IsSuccess)
            {
                byId = recipesResult.Value.ToDictionary(r => r.Id);
            }
        }

        _recent = recentEntries
            .Where(entry => byId.ContainsKey(entry.Id))
            .Take(CardRows)
            .Select(entry => new Row(entry.Id, byId[entry.Id].Name, PageMeta(byId[entry.Id])))
            .ToList();

        _favorites = favoriteIds
            .Where(byId.ContainsKey)
            .Take(CardRows)
            .Select(id => new Row(id, byId[id].Name, RatingMeta(byId[id].Rating)))
            .ToList();

        _toRate = unratedIds
            .Where(byId.ContainsKey)
            .Select(id => byId[id])
            .ToList();

        await LoadTagsAsync();
    }

    private async Task LoadTagsAsync()
    {
        try
        {
            var all = await EtiquetteService.GetAllAsync();
            var counts = await EtiquetteService.GetRecipeCountsAsync();

            // Les plus utilisées d'abord : une étiquette portée par une seule recette
            // n'est pas un raccourci, c'est une ligne de plus à lire.
            _topTags = all
                .Where(tag => counts.ContainsKey(tag.Id))
                .OrderByDescending(tag => counts[tag.Id])
                .ThenBy(tag => tag.Name)
                .Take(TagCount)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the frequent tags");
            _topTags = [];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _isApplePlatform = await JSRuntime.InvokeAsync<bool>("recettesShortcuts.isApple");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the platform for the shortcut badge");
        }
    }

    private Task OpenPalette() => PaletteLauncher.OpenAsync();

    /// <summary>
    /// Sets a rating without leaving the page, then drops the row from the list — it is no
    /// longer waiting for one.
    /// </summary>
    private async Task RateAsync(Recipe recipe, int rating)
    {
        if (rating <= 0 || !AuthService.IsAuthenticated)
        {
            return;
        }

        var updated = new Recipe
        {
            Id = recipe.Id,
            Name = recipe.Name,
            Rating = rating,
            Notes = recipe.Notes,
            BookId = recipe.BookId,
            BookPage = recipe.BookPage,
            StoreId = recipe.StoreId,
            Url = recipe.Url,
            CreationDate = recipe.CreationDate
        };

        var result = await RecipeService.UpdateAsync(updated);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "La note n'a pas pu être enregistrée.", Severity.Error);
            return;
        }

        _toRate.RemoveAll(r => r.Id == recipe.Id);
        _unratedTotal = Math.Max(0, _unratedTotal - 1);
        Snackbar.Add($"« {recipe.Name} » notée {rating} / 5.", Severity.Success);
    }

    private static string PageMeta(Recipe recipe) =>
        recipe.BookPage.HasValue ? $"p. {recipe.BookPage}" : string.Empty;

    private static string RatingMeta(int rating) => rating switch
    {
        <= 0 => "—",
        1 => "1 pizza",
        _ => $"{rating} pizzas"
    };
}
