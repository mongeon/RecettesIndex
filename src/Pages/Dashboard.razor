@page "/dashboard"
@using MudBlazor
@using RecettesIndex.Models
@using RecettesIndex.Services
@using RecettesIndex.Services.Abstractions
@using Microsoft.Extensions.Logging
@inject AuthService AuthService
@inject IRecipeService RecipeService
@inject ISnackbar Snackbar
@inject ILogger<Dashboard> Logger
@implements IDisposable

@*
    Le tableau de bord (bloc 5b).

    Quatre questions au lieu de quatre compteurs. « 42 recettes » ne dit rien qu'on ne
    sache déjà ; « qu'est-ce qui attend une note ? » se répond, et la réponse est
    cliquable. Chaque ligne mène à la recette ou au livre concerné.

    Contrainte tenue : aucun nouveau champ au modèle. Tout se calcule depuis la date
    d'ajout, la note, les étiquettes et la source. Une cinquième carte « qu'est-ce qu'on
    aime et qu'on a oublié » avait été proposée puis retirée parce qu'elle exigeait une
    date de dernière cuisson — la réintroduire par la bande serait la même erreur.
*@

<PageTitle>Tableau de bord - Mes Recettes</PageTitle>

<div class="dash">
    <header class="dash-head">
        <h1 class="dash-title">Tableau de bord</h1>
        @if (_view is not null)
        {
            <p class="dash-sub">@Summary</p>
        }
    </header>

    @if (_loading)
    {
        <div class="dash-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        </div>
    }
    else if (_view is null)
    {
        <p class="dash-failed">Le tableau de bord n'a pas pu être chargé. Réessayez plus tard.</p>
    }
    else
    {
        <div class="dash-cards">

            @* ── 1. Qu'est-ce qui attend une note ? ───────────────────────────── *@
            <section class="dash-card">
                <h2 class="dash-question">
                    Qu'est-ce qui attend une note&nbsp;?
                    @if (_view.UnratedTotal > 0)
                    {
                        <span class="dash-count">@_view.UnratedTotal</span>
                    }
                </h2>
                <p class="dash-why">Ajoutées mais jamais évaluées. Les pizzas se cliquent ici même.</p>

                @if (_view.Unrated.Count == 0)
                {
                    <p class="dash-empty">Tout est noté.</p>
                }
                else
                {
                    @foreach (var row in _view.Unrated)
                    {
                        <div class="dash-row">
                            <a class="dash-row-name" href="@($"/recipes/{row.Id}")">@row.Name</a>
                            <span class="dash-row-meta">@row.Since</span>
                            <PizzaRating Value="0"
                                         ReadOnly="@(!AuthService.IsAuthenticated)"
                                         Size="Size.Small"
                                         ValueChanged="@(v => RateAsync(row.Id, row.Name, v))" />
                        </div>
                    }
                }
            </section>

            @* ── 2. Quels livres dorment ? ────────────────────────────────────── *@
            <section class="dash-card">
                <h2 class="dash-question">
                    Quels livres dorment&nbsp;?
                    @if (_view.SleepingTotal > 0)
                    {
                        <span class="dash-count">@_view.SleepingTotal</span>
                    }
                </h2>
                <p class="dash-why">Aucune recette ajoutée depuis un an — ou jamais.</p>

                @if (_view.SleepingBooks.Count == 0)
                {
                    <p class="dash-empty">Tous les livres ont servi cette année.</p>
                }
                else
                {
                    @foreach (var row in _view.SleepingBooks)
                    {
                        <a class="dash-row" href="@($"/books/{row.Id}")">
                            <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Class="dash-row-icon" />
                            <span class="dash-row-name">@row.Name</span>
                            <span class="dash-row-meta">@RecipeCountLabel(row.RecipeCount)</span>
                            <span class="dash-row-meta dash-row-meta-accent">@row.Since</span>
                        </a>
                    }
                    <a class="dash-link" href="/books">Voir tous les livres →</a>
                }
            </section>

            @* ── 3. De quoi est faite ma collection ? ─────────────────────────── *@
            <section class="dash-card">
                <h2 class="dash-question">De quoi est faite ma collection&nbsp;?</h2>
                <p class="dash-why">Les étiquettes les plus posées, et ce qu'elles valent.</p>

                @if (_view.Tags.Count == 0)
                {
                    <p class="dash-empty">Aucune étiquette posée pour l'instant.</p>
                }
                else
                {
                    var widest = _view.Tags.Max(t => t.Count);
                    @foreach (var tag in _view.Tags)
                    {
                        <div class="dash-bar-row">
                            <span class="dash-bar-label">@tag.Name</span>
                            <span class="dash-bar-track">
                                <span class="dash-bar-fill" style="@Width(tag.Count, widest)"></span>
                            </span>
                            <span class="dash-bar-count">@tag.Count</span>
                            <span class="dash-bar-note">@AverageLabel(tag.AverageRating)</span>
                        </div>
                    }
                }

                @if (_view.UntaggedCount > 0)
                {
                    <p class="dash-foot">@RecipeCountLabel(_view.UntaggedCount) sans aucune étiquette.</p>
                }
            </section>

            @* ── 4. Est-ce que je note honnêtement ? ──────────────────────────── *@
            <section class="dash-card">
                <h2 class="dash-question">Est-ce que je note honnêtement&nbsp;?</h2>
                <p class="dash-why">La répartition des notes, les non évaluées comprises.</p>

                @{
                    var tallest = Math.Max(1, _view.Ratings.Max(r => r.Count));
                }
                @foreach (var row in _view.Ratings)
                {
                    <div class="dash-bar-row">
                        <span class="dash-bar-label dash-bar-label-short">
                            @if (row.Rating > 0)
                            {
                                @row.Rating
                                <MudIcon Icon="@Icons.Material.Filled.LocalPizza" Class="dash-bar-pizza" />
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </span>
                        <span class="dash-bar-track">
                            <span class="@(row.Rating >= 3 ? "dash-bar-fill" : "dash-bar-fill dash-bar-fill-muted")"
                                  style="@Width(row.Count, tallest)"></span>
                        </span>
                        <span class="dash-bar-count">@row.Count</span>
                    </div>
                }

                @if (_view.ReliableBooks.Count > 0)
                {
                    <div class="dash-sep"></div>
                    <div class="dash-label">Les livres qui tiennent leurs promesses</div>
                    @foreach (var book in _view.ReliableBooks)
                    {
                        <a class="dash-row" href="@($"/books/{book.Id}")">
                            <span class="dash-row-name">@book.Name</span>
                            <span class="dash-row-meta">@RecipeCountLabel(book.RecipeCount)</span>
                            <span class="dash-row-strong">@AverageLabel(book.AverageRating)</span>
                        </a>
                    }
                }
            </section>
        </div>
    }
</div>

@code {
    private DashboardView? _view;
    private bool _loading = true;

    private string Summary =>
        $"{RecipeCountLabel(_view!.TotalRecipes)} · {SourceCountLabel(_view.TotalSources)} · {AddedLabel(_view.AddedThisMonth)}";

    protected override void OnInitialized()
    {
        // Les pizzas de la première carte ne sont cliquables que connecté.
        AuthService.AuthStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => AuthService.AuthStateChanged -= OnAuthStateChanged;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var recipes = await LoadAllRecipesAsync();
            if (recipes is null)
            {
                // Un tableau de bord bâti sur une collection tronquée compte faux sans
                // le dire : mieux vaut ne rien montrer que des chiffres inventés.
                _view = null;
                return;
            }

            var books = (await RecipeService.GetBooksAsync())?.ToList() ?? [];
            var stores = (await RecipeService.GetStoresAsync())?.ToList() ?? [];

            _view = DashboardInsights.Build(recipes, books, stores, DateTime.UtcNow);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading the dashboard");
            // Sans cette remise à zéro, un rechargement raté laisserait la vue précédente
            // à l'écran — y compris la recette qu'on vient de noter, toujours listée comme
            // en attente de note.
            _view = null;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Every recipe, tags and book embedded — the four cards each need a different cut of
    /// the same data, and cutting it here beats four queries that could disagree.
    /// </summary>
    /// <returns>
    /// Every recipe, or null when the collection could not be read whole. Half a
    /// collection would produce a dashboard whose every figure is wrong and says so
    /// nowhere.
    /// </returns>
    /// <remarks>
    /// SearchAsync caps the page size, so this pages to the end rather than silently
    /// truncating the collection at that limit — the same loop the ⌘K palette runs.
    /// </remarks>
    private async Task<List<Recipe>?> LoadAllRecipesAsync()
    {
        var all = new List<Recipe>();
        var page = 1;

        while (true)
        {
            var result = await RecipeService.SearchAsync(
                null, null, null, null, null, page, PaginationConstants.MaxPageSize,
                RecipeSortConstants.CreatedAt, true);

            if (!result.IsSuccess)
            {
                Logger.LogError("Could not load the recipes for the dashboard: {Error}", result.ErrorMessage);
                return null;
            }

            all.AddRange(result.Value.Items);
            if (all.Count >= result.Value.Total || result.Value.Items.Count == 0)
            {
                break;
            }
            page++;
        }

        return all;
    }

    /// <summary>
    /// Rates a recipe from the list and rebuilds the view, because that one rating moves
    /// three of the four cards at once.
    /// </summary>
    private async Task RateAsync(int recipeId, string name, int rating)
    {
        if (rating <= 0 || !AuthService.IsAuthenticated || _view is null)
        {
            return;
        }

        var current = await RecipeService.GetByIdAsync(recipeId);
        if (!current.IsSuccess || current.Value is null)
        {
            Snackbar.Add(current.ErrorMessage ?? "La recette n'a pas pu être relue.", Severity.Error);
            return;
        }

        var updated = current.Value;
        updated.Rating = rating;

        var result = await RecipeService.UpdateAsync(updated);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "La note n'a pas pu être enregistrée.", Severity.Error);
            return;
        }

        Snackbar.Add($"« {name} » notée {rating} / 5.", Severity.Success);

        // Une note déplace trois des quatre cartes : plutôt que de les rapiécer une à une,
        // la vue se recalcule entièrement.
        _loading = true;
        StateHasChanged();
        await LoadAsync();
    }

    /// <summary>Bar width as a share of the tallest, floored so a lone recipe still shows.</summary>
    private static string Width(int value, int max) =>
        $"width: {(max <= 0 ? 0 : Math.Max(value > 0 ? 4 : 0, value * 100 / max))}%";

    private static string RecipeCountLabel(int count) =>
        count == 1 ? "1 recette" : $"{count} recettes";

    private static string SourceCountLabel(int count) =>
        count == 1 ? "1 source" : $"{count} sources";

    private static string AddedLabel(int count) => count switch
    {
        0 => "aucun ajout ce mois-ci",
        1 => "1 ajout ce mois-ci",
        _ => $"{count} ajouts ce mois-ci"
    };

    private static string AverageLabel(double average) =>
        average <= 0 ? "—" : average.ToString("0.#");
}
