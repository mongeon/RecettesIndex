@page "/recipes/{Id:int}"
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using MudBlazor
@using RecettesIndex.Models
@using RecettesIndex.Services
@using RecettesIndex.Services.Abstractions
@using RecettesIndex.Components
@inject AuthService AuthService
@inject IDialogService DialogService
@inject ILogger<RecipeDetails> Logger
@inject NavigationManager NavigationManager
@inject IRecipeService RecipeService
@inject ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Recette - @(recipe?.Name ?? "Chargement...")</PageTitle>

@if (loading)
{
    <MudContainer Class="d-flex flex-column align-center py-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Class="mt-4">Chargement de la recette...</MudText>
    </MudContainer>
}
else if (recipe == null)
{
    @if (!isNotFound && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">@errorMessage</MudAlert>
    }
    else
    {
        <EmptyState Icon="@Icons.Material.Filled.RestaurantMenu"
                    IconColor="Color.Secondary"
                    Title="Recette introuvable"
                    Message="Cette recette n'existe pas ou n'est plus disponible."
                    ShowAction="true"
                    ActionText="Retour aux recettes"
                    ActionIcon="@Icons.Material.Filled.ArrowBack"
                    OnActionClick="GoBackToRecipes" />
    }
}
else
{
    @* Le fil d'Ariane remplace le bandeau corail dégradé de 200px : une ligne de 13px
       suffit à dire où l'on est et à offrir le retour. *@
    <nav class="detail-crumbs" aria-label="Fil d'Ariane">
        <a class="detail-crumb-back" href="/recipes">← Recettes</a>
        @if (!string.IsNullOrEmpty(SourceCrumb))
        {
            <span class="detail-crumb-sep">·</span>
            <span class="detail-crumb-current">@SourceCrumb</span>
        }
    </nav>

    <header class="detail-head">
        <div class="detail-head-main">
            <h1 class="detail-title">@recipe.Name</h1>

            <div class="detail-meta">
                @if (recipe.Rating > 0)
                {
                    <PizzaRating ReadOnly="true" Value="@recipe.Rating" Size="Size.Small" />
                }
                <span class="detail-meta-text">@RatingLine</span>

                @foreach (var tag in recipe.Etiquettes)
                {
                    <a class="detail-tag" href="@($"/recipes?tags={tag.Id}")">@tag.Name</a>
                }
            </div>
        </div>

        <div class="detail-actions">
            <button type="button"
                    class="detail-action detail-action-accent"
                    aria-pressed="@IsFavorite"
                    @onclick="@(() => ToggleFavorite(recipe))">
                <MudIcon Icon="@(IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)" />
                <span>Favori</span>
            </button>

            <a class="detail-action" href="@($"/recipes/{Id}/print")">
                <MudIcon Icon="@Icons.Material.Outlined.Print" />
                <span>Imprimer</span>
            </a>

            @if (AuthService.IsAuthenticated)
            {
                <button type="button" class="detail-action detail-action-filled" @onclick="OpenEditDialog">
                    <MudIcon Icon="@Icons.Material.Outlined.Edit" />
                    <span>Modifier</span>
                </button>
            }
        </div>
    </header>

    <RecipeSourceBanner Recipe="@recipe"
                        Book="@book"
                        Store="@store"
                        SourceTotal="@sourceTotal"
                        IsAuthenticated="@AuthService.IsAuthenticated"
                        OnAssociateBook="@OpenEditDialog" />

    <div class="detail-columns">
        <section class="detail-notes">
            <div class="detail-notes-label">Mes notes</div>
            @if (!string.IsNullOrWhiteSpace(recipe.Notes))
            {
                <p class="detail-notes-body">@recipe.Notes</p>
            }
            else
            {
                <p class="detail-notes-empty">Aucune note pour cette recette.</p>
            }
        </section>

        <RecipeSourcePanel Title="@panelTitle"
                           Items="@panelItems"
                           Tags="@panelTags"
                           LinkText="@panelLinkText"
                           LinkHref="@panelLinkHref"
                           EmptyMessage="@panelEmptyMessage" />
    </div>
}

@code {
    /// <summary>How many neighbours the panel fetches before keeping the best few.</summary>
    private const int PanelPoolSize = 25;

    /// <summary>How many rows the panel shows. Beyond that it stops being a glance.</summary>
    private const int PanelRowCount = 5;

    [Parameter]
    public int Id { get; set; }

    private Recipe? recipe;
    private Book? book;
    private Store? store;
    private bool loading = true;
    private bool isNotFound;
    private string? errorMessage;
    private List<int> favoriteRecipeIds = new();
    private CancellationTokenSource? _loadCts;

    // ── Contexte de la source (bandeau + panneau latéral) ─────────────────────
    private int sourceTotal;
    private string panelTitle = string.Empty;
    private List<RecipeSourcePanel.Item> panelItems = new();
    private List<Etiquette>? panelTags;
    private string? panelLinkText;
    private string? panelLinkHref;
    private string panelEmptyMessage = "Rien d'autre pour l'instant.";

    private bool IsFavorite => recipe is not null && favoriteRecipeIds.Contains(recipe.Id);

    private RecipeSourceKind SourceKind =>
        recipe is null ? RecipeSourceKind.Home : RecipeSource.Classify(recipe);

    /// <summary>The second half of the breadcrumb — the place this recipe lives.</summary>
    private string SourceCrumb => SourceKind switch
    {
        RecipeSourceKind.Book => book?.Name ?? string.Empty,
        RecipeSourceKind.Store => store?.Name ?? string.Empty,
        RecipeSourceKind.Web => RecipeSource.SplitUrl(recipe?.Url).Domain,
        _ => "Recette maison"
    };

    private string RatingLine
    {
        get
        {
            var added = $"ajoutée le {recipe?.CreationDate.ToString("d MMMM yyyy")}";
            return recipe is { Rating: > 0 } ? $"{recipe.Rating} / 5 · {added}" : $"Pas encore notée · {added}";
        }
    }

    protected override void OnInitialized()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        favoriteRecipeIds = await LocalStorage.GetFavoritesAsync();

        await LoadRecipeData();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Called when the route parameter changes (navigating from recipe 1 to recipe 2),
        // which has to reload everything, side panel included.
        await LoadRecipeData();
    }

    private async Task LoadRecipeData()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        loading = true;
        isNotFound = false;
        errorMessage = null;
        recipe = null;
        book = null;
        store = null;
        ResetSourceContext();

        try
        {
            var recipeResult = await RecipeService.GetByIdAsync(Id, ct);
            if (!recipeResult.IsSuccess || recipeResult.Value == null)
            {
                var message = recipeResult.ErrorMessage ?? string.Empty;
                isNotFound = message.Contains("not found", StringComparison.OrdinalIgnoreCase)
                    || message.Contains("introuvable", StringComparison.OrdinalIgnoreCase);

                if (!isNotFound)
                {
                    errorMessage = string.IsNullOrWhiteSpace(message)
                        ? "Impossible de charger cette recette pour le moment. Veuillez réessayer."
                        : message;
                }

                return;
            }

            recipe = recipeResult.Value;
            book = recipe.Book;
            store = recipe.Store;

            await LoadSourceContext(ct);
            await LocalStorage.AddRecentRecipeAsync(recipe.Id, recipe.Name);
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation triggered by route changes
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading recipe {RecipeId}", Id);
            errorMessage = "Impossible de charger cette recette pour le moment. Veuillez réessayer.";
        }
        finally
        {
            loading = false;
        }
    }

    private void ResetSourceContext()
    {
        sourceTotal = 0;
        panelTitle = string.Empty;
        panelItems = new List<RecipeSourcePanel.Item>();
        panelTags = null;
        panelLinkText = null;
        panelLinkHref = null;
        panelEmptyMessage = "Rien d'autre pour l'instant.";
    }

    /// <summary>
    /// Fills the source banner's count and the side panel's rows.
    /// </summary>
    /// <remarks>
    /// Never lets the panel stay empty when something can be listed: a single-recipe book or
    /// a lone home recipe falls back to the recipes sharing a tag. The failure of any of
    /// these queries degrades the panel, never the page — the recipe itself is already there.
    /// </remarks>
    private async Task LoadSourceContext(CancellationToken ct)
    {
        if (recipe is null)
        {
            return;
        }

        try
        {
            switch (SourceKind)
            {
                case RecipeSourceKind.Book:
                    await LoadBookContext(ct);
                    break;
                case RecipeSourceKind.Store:
                    await LoadStoreContext(ct);
                    break;
                case RecipeSourceKind.Web:
                    await LoadWebContext(ct);
                    break;
                default:
                    await LoadHomeContext(ct);
                    break;
            }

            if (panelItems.Count == 0)
            {
                await LoadTagContext(ct);
            }
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading source context for recipe {RecipeId}", Id);
        }
    }

    private async Task LoadBookContext(CancellationToken ct)
    {
        panelTitle = "Aussi dans ce livre";
        panelEmptyMessage = "C'est la seule recette de ce livre pour l'instant.";

        var result = await RecipeService.SearchAsync(
            term: null, rating: null, bookId: recipe!.BookId, storeId: null, authorId: null,
            page: 1, pageSize: PanelPoolSize,
            sortLabel: RecipeSortConstants.Name, sortDescending: false, ct: ct);

        if (!result.IsSuccess)
        {
            return;
        }

        sourceTotal = result.Value.Total;
        panelItems = result.Value.Items
            .Where(r => r.Id != recipe.Id)
            .Take(PanelRowCount)
            .Select(r => new RecipeSourcePanel.Item(r.Id, r.Name, r.BookPage.HasValue ? $"p. {r.BookPage}" : "—"))
            .ToList();

        if (book is not null && sourceTotal > 1)
        {
            panelLinkText = $"Voir les {sourceTotal} recettes →";
            panelLinkHref = $"/books/{book.Id}";
        }
    }

    private async Task LoadStoreContext(CancellationToken ct)
    {
        panelTitle = "Aussi de ce commerce";
        panelEmptyMessage = "C'est la seule recette de ce commerce pour l'instant.";

        var result = await RecipeService.SearchAsync(
            term: null, rating: null, bookId: null, storeId: recipe!.StoreId, authorId: null,
            page: 1, pageSize: PanelPoolSize,
            sortLabel: RecipeSortConstants.Rating, sortDescending: true, ct: ct);

        if (!result.IsSuccess)
        {
            return;
        }

        sourceTotal = result.Value.Total;
        panelItems = result.Value.Items
            .Where(r => r.Id != recipe.Id)
            .Take(PanelRowCount)
            .Select(r => new RecipeSourcePanel.Item(r.Id, r.Name, RatingMeta(r.Rating)))
            .ToList();

        if (store is not null)
        {
            panelLinkText = "Voir le commerce →";
            panelLinkHref = $"/stores/{store.Id}";
        }
    }

    private async Task LoadWebContext(CancellationToken ct)
    {
        panelTitle = "Aussi de ce site";
        panelEmptyMessage = "C'est la seule recette prise sur ce site pour l'instant.";

        var domain = RecipeSource.Domain(recipe!.Url);
        // Aucun filtre de la page Recettes ne reproduit « même domaine » : le panneau se
        // passe donc de lien de bas de carte plutôt que d'en offrir un qui retomberait
        // sur la liste complète.
        await LoadFromSummaries(
            ct,
            match: r => RecipeSource.Domain(r.Url) == domain,
            rank: r => r.Rating);
    }

    private async Task LoadHomeContext(CancellationToken ct)
    {
        panelTitle = "Autres recettes maison · mieux notées";
        panelEmptyMessage = "C'est la seule recette maison pour l'instant.";

        await LoadFromSummaries(
            ct,
            match: r => !r.BookId.HasValue && !r.StoreId.HasValue && !r.IsFromUrl,
            rank: r => r.Rating);
    }

    /// <summary>
    /// Builds the panel from the lightweight summaries, for the two groupings the search API
    /// cannot express: « same site » and « home recipes », both of which are defined by the
    /// <em>absence</em> of a book and a store.
    /// </summary>
    private async Task LoadFromSummaries(
        CancellationToken ct,
        Func<Recipe, bool> match,
        Func<Recipe, int> rank)
    {
        var summariesResult = await RecipeService.GetRecipeSummariesAsync(null, ct);
        if (!summariesResult.IsSuccess)
        {
            return;
        }

        var peers = summariesResult.Value.Where(match).ToList();
        sourceTotal = peers.Count;

        var top = peers
            .Where(r => r.Id != recipe!.Id)
            .OrderByDescending(rank)
            .ThenByDescending(r => r.CreationDate)
            .Take(PanelRowCount)
            .ToList();

        if (top.Count == 0)
        {
            return;
        }

        // Les résumés n'ont pas le nom des recettes ; il faut une seconde requête, mais
        // seulement pour les quelques lignes retenues.
        var namesResult = await RecipeService.GetRecipesByIdsAsync(top.Select(r => r.Id).ToList(), ct);
        if (!namesResult.IsSuccess)
        {
            return;
        }

        var byId = namesResult.Value.ToDictionary(r => r.Id);
        panelItems = top
            .Where(r => byId.ContainsKey(r.Id))
            .Select(r => new RecipeSourcePanel.Item(r.Id, byId[r.Id].Name, RatingMeta(r.Rating)))
            .ToList();
    }

    /// <summary>
    /// Last resort: the recipes sharing a tag with this one, so the panel is never empty
    /// when the recipe is alone at its source.
    /// </summary>
    /// <remarks>
    /// One query per tag, unioned. The filter bar reads several tags as a narrowing AND,
    /// which is the right reading there and the wrong one here: a fallback that intersects
    /// would come back empty exactly when it is needed.
    /// </remarks>
    private async Task LoadTagContext(CancellationToken ct)
    {
        if (recipe is null || recipe.Etiquettes.Count == 0)
        {
            return;
        }

        var found = new Dictionary<int, Recipe>();

        foreach (var tag in recipe.Etiquettes)
        {
            var result = await RecipeService.SearchAsync(
                term: null, rating: null, bookId: null, storeId: null, authorId: null,
                page: 1, pageSize: PanelPoolSize,
                sortLabel: RecipeSortConstants.Rating, sortDescending: true,
                etiquetteIds: [tag.Id], ct: ct);

            if (!result.IsSuccess)
            {
                continue;
            }

            foreach (var candidate in result.Value.Items.Where(r => r.Id != recipe.Id))
            {
                found.TryAdd(candidate.Id, candidate);
            }

            if (found.Count >= PanelRowCount)
            {
                break;
            }
        }

        if (found.Count == 0)
        {
            return;
        }

        panelTitle = "Mêmes étiquettes";
        panelTags = recipe.Etiquettes;
        panelLinkText = null;
        panelLinkHref = null;
        panelItems = found.Values
            .OrderByDescending(r => r.Rating)
            .Take(PanelRowCount)
            .Select(r => new RecipeSourcePanel.Item(r.Id, r.Name, RatingMeta(r.Rating)))
            .ToList();
    }

    private static string RatingMeta(int rating) => rating switch
    {
        <= 0 => "—",
        1 => "1 pizza",
        _ => $"{rating} pizzas"
    };

    private Task GoBackToRecipes()
    {
        NavigationManager.NavigateTo("/recipes");
        return Task.CompletedTask;
    }

    private async Task ToggleFavorite(Recipe recipeToToggle)
    {
        await LocalStorage.ToggleFavoriteAsync(recipeToToggle.Id);

        favoriteRecipeIds = await LocalStorage.GetFavoritesAsync();

        StateHasChanged();

        var isFavorite = favoriteRecipeIds.Contains(recipeToToggle.Id);
        Snackbar.Add(
            isFavorite ? $"'{recipeToToggle.Name}' ajouté aux favoris ❤️" : $"'{recipeToToggle.Name}' retiré des favoris",
            isFavorite ? Severity.Success : Severity.Info
        );
    }

    private async Task OpenEditDialog()
    {
        if (recipe != null)
        {
            var parameters = new DialogParameters();
            parameters.Add("RecipeToEdit", recipe);

            var dialogOptions = new MudBlazor.DialogOptions { CloseButton = true, BackdropClick = false };
            var dialog = await DialogService.ShowAsync<EditRecipeDialog>("Modifier la recette", parameters, dialogOptions);
            var result = await dialog.Result;

            if (result is not null && !result.Canceled && result.Data is Recipe)
            {
                // Rechargement complet plutôt que réutilisation de la recette renvoyée :
                // la source a pu changer — associer un livre est justement l'action que
                // propose le bandeau d'une recette maison — et le bandeau comme le panneau
                // ont besoin du livre et du commerce joints, que le dialogue ne rapporte pas.
                await LoadRecipeData();
                StateHasChanged();
            }
        }
    }

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        AuthService.AuthStateChanged -= OnAuthStateChanged;
    }
}
