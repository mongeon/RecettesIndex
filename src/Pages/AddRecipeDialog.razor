@using MudBlazor
@using RecettesIndex.Models
@using RecettesIndex.Components
@using RecettesIndex.Services
@using RecettesIndex.Services.Abstractions
@using Microsoft.Extensions.Logging
@inject IRecipeService RecipeService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IEtiquetteService EtiquetteService
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@inject ILogger<AddRecipeDialog> Logger

@*
    La boîte d'ajout (bloc 4a).

    Elle ne dessine plus rien elle-même : le corps est RecipeForm, partagé avec la boîte
    de modification. Ce qui lui reste en propre est ce qui n'a de sens qu'à l'ajout —
    « Enregistrer et ajouter une autre », qui garde la source pour saisir un livre entier
    d'un coup sans rouvrir la boîte cinq fois.
*@

<MudDialog Class="rform-dialog">
    <DialogContent>
        <div class="rform-shell" @onkeydown="OnKeyDown">
            <RecipeForm Model="@_model" Books="@_books" Stores="@_stores" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="rform-foot">
            <span class="rform-foot-hint">@ShortcutHint pour enregistrer</span>
            <div class="rform-foot-actions">
                <button type="button" class="rform-btn" disabled="@_saving" @onclick="Cancel">Annuler</button>
                <button type="button" class="rform-btn rform-btn-outline" disabled="@_saving"
                        @onclick="@(() => SaveAsync(keepGoing: true))">
                    Enregistrer et ajouter une autre
                </button>
                <button type="button" class="rform-btn rform-btn-filled" disabled="@_saving"
                        @onclick="@(() => SaveAsync(keepGoing: false))">
                    @(_saving ? "Enregistrement…" : "Enregistrer")
                </button>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    /// <summary>
    /// Preselects a source. Lets « Ajouter de ce livre » open the dialog already pointed at
    /// the right book instead of making the user find it again.
    /// </summary>
    [Parameter] public Book? PresetBook { get; set; }

    [Parameter] public Store? PresetStore { get; set; }

    private RecipeFormModel _model = new();
    private RecipeFormModel _pristine = new();
    private List<Book> _books = [];
    private List<Store> _stores = [];
    private string? _error;
    private bool _saving;
    private bool _addedAny;
    private Recipe? _last;

    /// <summary>
    /// « ⌘⏎ » ou « Ctrl+Entrée » selon la plateforme. Le même appel JS que le raccourci
    /// ⌘K de la barre du haut : afficher ⌘ à un utilisateur Windows lui montre un symbole
    /// absent de son clavier, quand il ne s'affiche pas carrément en carré.
    /// </summary>
    private bool _isApplePlatform;

    private string ShortcutHint => _isApplePlatform ? "⌘⏎" : "Ctrl+Entrée";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _books = (await RecipeService.GetBooksAsync())?.ToList() ?? [];
            _stores = (await RecipeService.GetStoresAsync())?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading books and stores");
        }

        try
        {
            _isApplePlatform = await JSRuntime.InvokeAsync<bool>("recettesShortcuts.isApple");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the platform for the save shortcut hint");
        }

        if (PresetBook is not null)
        {
            _model.Source = RecipeSourceKind.Book;
            _model.Book = PresetBook;
        }
        else if (PresetStore is not null)
        {
            _model.Source = RecipeSourceKind.Store;
            _model.Store = PresetStore;
        }

        _pristine = _model.Clone();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await SaveAsync(keepGoing: false);
        }
    }

    private async Task SaveAsync(bool keepGoing)
    {
        _error = _model.Validate();
        if (_error is not null)
        {
            return;
        }

        _saving = true;
        try
        {
            var recipe = new Recipe { CreationDate = DateTime.UtcNow };
            _model.ApplyTo(recipe);

            var result = await RecipeService.CreateAsync(recipe);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.ErrorMessage ?? "Échec lors de l'ajout de la recette.";
                Snackbar.Add(_error, Severity.Error);
                return;
            }

            await AttachAsideAsync(result.Value.Id);

            _addedAny = true;
            _last = result.Value;
            Snackbar.Add($"« {result.Value.Name} » ajoutée.", Severity.Success);

            if (keepGoing)
            {
                // La source reste en place : c'est tout l'intérêt du bouton.
                _model.ResetForNext();
                _pristine = _model.Clone();
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error adding recipe");
            _error = "Une erreur inattendue s'est produite.";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Writes what only exists once the recipe has an ID: its tags, and its place among
    /// the favourites. Neither failure loses the recipe, so neither is reported as one.
    /// </summary>
    private async Task AttachAsideAsync(int recipeId)
    {
        if (_model.EtiquetteIds.Count > 0)
        {
            var tags = await EtiquetteService.SetForRecipeAsync(recipeId, _model.EtiquetteIds);
            if (!tags.IsSuccess)
            {
                Snackbar.Add(tags.ErrorMessage ?? "Les étiquettes n'ont pas pu être enregistrées.", Severity.Warning);
            }
        }

        if (_model.IsFavorite)
        {
            try
            {
                await LocalStorage.ToggleFavoriteAsync(recipeId);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not mark recipe {RecipeId} as a favourite", recipeId);
            }
        }
    }

    private async Task Cancel()
    {
        if (_model.DiffersFrom(_pristine))
        {
            bool? confirm = await DialogService.ShowMessageBoxAsync(
                "Modifications non sauvegardées",
                "Voulez-vous vraiment fermer et perdre la recette en cours de saisie ?",
                yesText: "Fermer",
                cancelText: "Continuer la saisie");
            if (confirm != true)
            {
                return;
            }
        }

        // Enchaîner plusieurs recettes puis fermer doit quand même rafraîchir la liste
        // derrière : la boîte a bel et bien écrit quelque chose.
        if (_addedAny)
        {
            MudDialog.Close(DialogResult.Ok(_last));
            return;
        }

        MudDialog.Cancel();
    }
}
