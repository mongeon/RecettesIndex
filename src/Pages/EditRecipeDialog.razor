@using MudBlazor
@using RecettesIndex.Models
@using RecettesIndex.Components
@using RecettesIndex.Services
@using RecettesIndex.Services.Abstractions
@using Microsoft.Extensions.Logging
@inject IRecipeService RecipeService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IEtiquetteService EtiquetteService
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@inject ILogger<EditRecipeDialog> Logger

@*
    La boîte de modification (bloc 4b).

    Même corps que l'ajout, au champ près : c'est RecipeForm qui le rend, et
    RecipeFormModel qui porte les règles. Les deux boîtes ne peuvent donc plus diverger
    sur ce qui est obligatoire ou sur ce qu'il faut effacer en changeant de source.
*@

<MudDialog Class="rform-dialog">
    <DialogContent>
        <div class="rform-shell" @onkeydown="OnKeyDown">
            <RecipeForm Model="@_model" Books="@_books" Stores="@_stores" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="rform-foot">
            <span class="rform-foot-hint">@ShortcutHint pour enregistrer</span>
            <div class="rform-foot-actions">
                <button type="button" class="rform-btn" disabled="@_saving" @onclick="Cancel">Annuler</button>
                <button type="button" class="rform-btn rform-btn-filled" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Enregistrement…" : "Enregistrer")
                </button>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public Recipe RecipeToEdit { get; set; } = new();

    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    private RecipeFormModel _model = new();
    private RecipeFormModel _pristine = new();
    private List<Book> _books = [];
    private List<Store> _stores = [];
    private string? _error;
    private bool _saving;
    private bool _isApplePlatform;
    private bool _wasFavorite;

    private string ShortcutHint => _isApplePlatform ? "⌘⏎" : "Ctrl+Entrée";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _books = (await RecipeService.GetBooksAsync())?.ToList() ?? [];
            _stores = (await RecipeService.GetStoresAsync())?.ToList() ?? [];

            var favorites = await LocalStorage.GetFavoritesAsync();
            _wasFavorite = favorites.Contains(RecipeToEdit.Id);

            _model = RecipeFormModel.From(RecipeToEdit, _books, _stores, _wasFavorite);
            _pristine = _model.Clone();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing edit dialog");
            _error = "Erreur lors du chargement des données.";
        }

        try
        {
            _isApplePlatform = await JSRuntime.InvokeAsync<bool>("recettesShortcuts.isApple");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the platform for the save shortcut hint");
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        _error = _model.Validate();
        if (_error is not null)
        {
            return;
        }

        _saving = true;
        try
        {
            var recipe = new Recipe
            {
                Id = RecipeToEdit.Id,
                CreationDate = RecipeToEdit.CreationDate
            };
            _model.ApplyTo(recipe);

            var result = await RecipeService.UpdateAsync(recipe);
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage ?? "Échec lors de la mise à jour de la recette.";
                Snackbar.Add(_error, Severity.Error);
                return;
            }

            // Après la recette : les étiquettes vivent dans leur propre table et n'ont de
            // sens qu'une fois la mise à jour acceptée. L'échec ici ne perd pas la recette,
            // donc il ne se raconte pas comme un échec.
            var tags = await EtiquetteService.SetForRecipeAsync(recipe.Id, _model.EtiquetteIds);
            if (!tags.IsSuccess)
            {
                Snackbar.Add(tags.ErrorMessage ?? "Les étiquettes n'ont pas pu être enregistrées.", Severity.Warning);
            }

            if (_model.IsFavorite != _wasFavorite)
            {
                try
                {
                    await LocalStorage.ToggleFavoriteAsync(recipe.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Could not update the favourite state of recipe {RecipeId}", recipe.Id);
                }
            }

            Snackbar.Add("Recette modifiée.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error updating recipe");
            _error = "Une erreur inattendue s'est produite.";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Cancel()
    {
        if (_model.DiffersFrom(_pristine))
        {
            bool? confirm = await DialogService.ShowMessageBoxAsync(
                "Modifications non sauvegardées",
                "Voulez-vous vraiment fermer et perdre les modifications en cours ?",
                yesText: "Fermer",
                cancelText: "Continuer la modification");
            if (confirm != true)
            {
                return;
            }
        }
        MudDialog.Cancel();
    }
}
